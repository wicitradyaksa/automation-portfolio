{
  "name": "DCO Engine (Creative Performance Loop)",
  "nodes": [
    {
      "id": "aa4128ff-cfc8-4413-9b85-618be1d34eb1",
      "name": "Note - Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -360
      ],
      "parameters": {
        "content": "## DCO Engine \u2014 Creative Performance Loop\nCloses the loop between spend and revenue. Pulls ad-platform spend and affiliate\nconversions, joins them on sub_id, rolls up to per-variant CTR/CVR/CPA/ROAS/EPC,\nthen refuses to decide anything until a variant clears a volume floor AND a\nsignificance test. Winners get a capped 20% budget step, losers get paused and\nautomatically queue a replacement brief into Project 5 \u2014 so the creative pipeline\nrefills itself.",
        "height": 270,
        "width": 560,
        "color": 5
      }
    },
    {
      "id": "50ca3269-f834-4d3b-bb2c-e5d2d6fdd97a",
      "name": "Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -60,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      }
    },
    {
      "id": "dad50b0e-01e8-4df5-8cf8-49db0fb44760",
      "name": "Fetch Ad Platform Insights",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        160,
        -110
      ],
      "parameters": {
        "method": "GET",
        "url": "={{$env.ADS_API_URL}}/insights",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "level",
              "value": "ad"
            },
            {
              "name": "date_preset",
              "value": "last_3d"
            },
            {
              "name": "fields",
              "value": "ad_id,ad_name,adset_id,campaign_id,impressions,clicks,spend"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.ADS_API_TOKEN}}"
            }
          ]
        },
        "options": {
          "timeout": 60000,
          "pagination": {
            "pagination": {
              "paginationMode": "responseContainsNextURL",
              "nextURL": "={{$response.body.paging?.next}}",
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.paging?.next }}"
            }
          }
        }
      },
      "notes": "Spend side of the ledger. Paginated + retried \u2014 ad APIs rate-limit\nhard and a partial pull would silently skew every decision below.",
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 10000
    },
    {
      "id": "4ec565a6-6226-42d2-b555-9537a0f4dfa8",
      "name": "Fetch Affiliate Conversions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        160,
        110
      ],
      "parameters": {
        "method": "GET",
        "url": "={{$env.AFFILIATE_API_URL}}/conversions",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "since",
              "value": "={{ $now.minus(3, 'days').toISO() }}"
            },
            {
              "name": "group_by",
              "value": "sub_id"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Key",
              "value": "={{$env.AFFILIATE_API_KEY}}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "notes": "Revenue side. sub_id carries the ad_id through the click,\nwhich is what lets the two sources be joined at all.",
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 10000
    },
    {
      "id": "d528c3fd-8438-41e1-b837-5c850325b31d",
      "name": "Wait For Both Pulls",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        420,
        0
      ],
      "parameters": {
        "mode": "append",
        "options": {}
      },
      "notes": "Synchronisation point only: waits until both API pulls have finished.\nThe ad_id <-> sub_id join happens in Compute Variant Metrics."
    },
    {
      "id": "e9e59584-7ebf-47ac-a498-3c207a40c439",
      "name": "Compute Variant Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        0
      ],
      "parameters": {
        "jsCode": "// Join spend (ad platform) to revenue (affiliate network) on ad_id <-> sub_id, then\n// roll up to one record per creative variant with the metrics a buyer decides on.\nconst MIN_IMPRESSIONS = Number($env.DCO_MIN_IMPRESSIONS || 1000);\nconst TARGET_ROAS     = Number($env.DCO_TARGET_ROAS || 1.3);\n\n// Each HTTP item is one API page ({ data: [...] }); flatten pages into rows.\nconst rowsOf = node => $(node).all().flatMap(i => i.json.data || i.json.conversions || [i.json]);\nconst spendRows = rowsOf('Fetch Ad Platform Insights');\nconst revenueBySub = {};\nfor (const r of rowsOf('Fetch Affiliate Conversions')) {\n  const k = String(r.sub_id || '');\n  const acc = revenueBySub[k] ||= { conversions: 0, revenue: 0 };\n  acc.conversions += Number(r.conversions || 0);\n  acc.revenue     += Number(r.revenue || r.payout || 0);\n}\n\nconst byVariant = {};\nfor (const r of spendRows) {\n  // ad_name convention: campaign__variantId__placement\n  const variantId = (r.ad_name || '').split('__')[1] || r.ad_id;\n  const v = byVariant[variantId] ||= {\n    variantId, adIds: [], adSetId: r.adset_id, campaignId: r.campaign_id,\n    isControl: variantId.endsWith('_control'), currentBudget: Number(r.daily_budget || 0),\n    impressions: 0, clicks: 0, spend: 0, conversions: 0, revenue: 0\n  };\n  if (!v.adIds.includes(r.ad_id)) v.adIds.push(r.ad_id);\n  const rev = revenueBySub[String(r.ad_id)] || { conversions: 0, revenue: 0 };\n  v.impressions += Number(r.impressions || 0);\n  v.clicks      += Number(r.clicks || 0);\n  v.spend       += Number(r.spend || 0);\n  v.conversions += rev.conversions;\n  v.revenue     += rev.revenue;\n}\n\nreturn Object.values(byVariant).map(v => {\n  const ctr  = v.impressions ? v.clicks / v.impressions : 0;\n  const cvr  = v.clicks ? v.conversions / v.clicks : 0;\n  const cpa  = v.conversions ? v.spend / v.conversions : null;\n  const roas = v.spend ? v.revenue / v.spend : 0;\n  const epc  = v.clicks ? v.revenue / v.clicks : 0;\n  return { json: { ...v,\n    ctr, cvr, cpa, roas, epc,\n    targetRoas: TARGET_ROAS,\n    // Below the volume floor nothing is decided: noise is not a signal.\n    hasEnoughData: v.impressions >= MIN_IMPRESSIONS && v.clicks >= 100,\n    evaluatedAt: new Date().toISOString()\n  }};\n});"
      }
    },
    {
      "id": "2c6ac503-66d7-4da7-9a15-917ec2661ec0",
      "name": "Enough Data To Decide?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        860,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{$json.hasEnoughData}}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "id": "53d4435b-3466-5057-99f7-ecb75087816c"
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "66f9a9f0-b464-48f4-b747-61b17c0d71ac",
      "name": "Run Significance Test",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1080,
        -110
      ],
      "parameters": {
        "command": "=python3 /data/scripts/ab_significance.py --variants '{{ JSON.stringify($input.all().map(i => i.json)).replaceAll(\"'\", \"\") }}' --metric cvr --alpha 0.05"
      },
      "notes": "Two-proportion z-test against the campaign control, with a\nBonferroni correction for the number of variants under test.\nWithout this you are just chasing noise.",
      "executeOnce": true
    },
    {
      "id": "1d3483c2-7142-4cc4-9c81-4a97d3ca7553",
      "name": "Parse Test Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        -110
      ],
      "parameters": {
        "jsCode": "let res;\ntry { res = JSON.parse($input.first().json.stdout); }\ncatch (e) { throw new Error(`ab_significance.py did not return JSON: ${$input.first().json.stdout?.slice(0,200)}`); }\n\n// res.variants[] carries { variantId, adId, adSetId, pValue, significant, lift, decision, ... }\nreturn res.variants.map(v => {\n  // Never scale a budget we can't read: 0 * 1.2 would set the ad set to zero.\n  if (v.decision === 'scale' && !(Number(v.currentBudget) > 0)) {\n    return { json: { ...v, decision: 'hold', reason: 'scale blocked: current budget unknown' } };\n  }\n  return { json: v };\n});"
      }
    },
    {
      "id": "c96c9462-8000-460f-aeb2-9706c3a24cd3",
      "name": "Route Decision",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        1520,
        -110
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{$json.decision}}",
                    "rightValue": "scale",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "scale"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{$json.decision}}",
                    "rightValue": "pause",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "pause"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{$json.decision}}",
                    "rightValue": "hold",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "hold"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "ee41a949-3fef-4a66-9c98-69aaa91283fc",
      "name": "Scale Winner Budget",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        -260
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env.ADS_API_URL}}/adsets/{{$json.adSetId}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ daily_budget: Math.round($json.currentBudget * Number($env.DCO_SCALE_STEP || 1.2)) }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.ADS_API_TOKEN}}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "notes": "Budget steps up by 20% per cycle, never more. Doubling a winning\nad set overnight resets learning and usually kills the winner.",
      "retryOnFail": true,
      "maxTries": 3
    },
    {
      "id": "a947ea22-abbf-4b6e-bddf-e0c202d6d66a",
