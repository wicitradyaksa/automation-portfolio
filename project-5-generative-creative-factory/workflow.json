{
  "name": "Generative Creative Factory (ComfyUI)",
  "nodes": [
    {
      "id": "99f51dd7-59e7-41ff-b5dd-4c7a0ba2c065",
      "name": "Note - Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -360
      ],
      "parameters": {
        "content": "## Generative Creative Factory (ComfyUI / SDXL)\nMarketing fills a row in a Google Sheet; this builds the ComfyUI API-format node graph\nfrom it, queues the job on the GPU box, polls /history until the images land (with a\nhard give-up at ~5 minutes so a wedged queue can't hang the workflow forever), then\npost-processes every output in Python into the ad placement sizes and hands video\nbriefs off to Project 4. No one touches the ComfyUI node editor.",
        "height": 270,
        "width": 560,
        "color": 6
      }
    },
    {
      "id": "4641bb35-8a2a-4333-ae8b-b85ff5563785",
      "name": "Every Morning 06:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -60,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "6ca9d150-bdfd-4e74-8d82-3ae7b1e2ecc4",
      "name": "Read Creative Briefs",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        160,
        0
      ],
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.CREATIVE_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Creative Briefs",
          "mode": "name"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "status",
              "lookupValue": "queued"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "gsheets_cred5",
          "name": "Google Sheets - Creative Ops (demo)"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "30b5a69c-757b-434b-b577-b41a081e3d1f",
      "name": "Any Briefs Queued?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        380,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.briefId ?? '' }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              },
              "id": "1a0e3b97-4aa0-5a54-9254-269d28447295"
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "497c4f74-98dd-4f49-beda-d60e7d7be459",
      "name": "One Brief At A Time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        600,
        -80
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "51000292-5e1f-4b35-9052-a25c6086596d",
      "name": "Build ComfyUI Graph",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        820,
        -80
      ],
      "parameters": {
        "jsCode": "// ComfyUI's /prompt endpoint takes a node graph in 'API format'. We build it\n// programmatically from the brief row so marketing never touches the node editor.\nconst b = $input.first().json;\n\nconst seed = b.seed && Number(b.seed) ? Number(b.seed) : Math.floor(Math.random() * 1e15);\nconst steps = Number(b.steps) || 28;\nconst cfg   = Number(b.cfg)   || 6.5;\nconst w     = Number(b.width) || 1024;\nconst h     = Number(b.height)|| 1024;\n\nconst positive = [b.subject, b.style, b.lighting, 'high detail, commercial product photography']\n  .filter(Boolean).join(', ');\nconst negative = b.negative || 'text, watermark, logo, lowres, deformed hands, extra limbs';\n\nconst graph = {\n  '1': { class_type: 'CheckpointLoaderSimple',\n         inputs: { ckpt_name: b.checkpoint || 'sd_xl_base_1.0.safetensors' } },\n  '2': { class_type: 'CLIPTextEncode', inputs: { text: positive, clip: ['1', 1] } },\n  '3': { class_type: 'CLIPTextEncode', inputs: { text: negative, clip: ['1', 1] } },\n  '4': { class_type: 'EmptyLatentImage',\n         inputs: { width: w, height: h, batch_size: Number(b.batchSize) || 4 } },\n  '5': { class_type: 'KSampler',\n         inputs: { seed, steps, cfg, sampler_name: 'dpmpp_2m', scheduler: 'karras',\n                   denoise: 1, model: ['1', 0], positive: ['2', 0],\n                   negative: ['3', 0], latent_image: ['4', 0] } },\n  '6': { class_type: 'VAEDecode', inputs: { samples: ['5', 0], vae: ['1', 2] } },\n  '7': { class_type: 'SaveImage',\n         inputs: { filename_prefix: `campaign/${b.campaign}/${b.briefId}`, images: ['6', 0] } }\n};\n\nreturn [{ json: {\n  briefId: b.briefId, campaign: b.campaign, rowNumber: b.row_number,\n  seed, steps, cfg, width: w, height: h,\n  positivePrompt: positive,\n  payload: { prompt: graph, client_id: `n8n-${b.briefId}` },\n  // Optional: briefs with a master video are handed to the Render Farm (Project 4).\n  videoSourcePath: b.videoSourcePath || null,\n  hooks: String(b.hooks || '').split('|').map(s => s.trim()).filter(Boolean),\n  attempt: 0, startedAt: new Date().toISOString()\n}}];"
      }
    },
    {
      "id": "2a0bc6f1-132d-4f7a-bf4d-494a905731cc",
      "name": "Queue On ComfyUI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        -80
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env.COMFYUI_URL}}/prompt",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}",
        "options": {
          "timeout": 30000
        }
      },
      "notes": "Returns { prompt_id }. Generation is async \u2014 we poll /history below.",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "be0a9188-309b-474b-80c9-66cce8e1a6c5",
      "name": "Wait 20s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1260,
        -80
      ],
      "parameters": {
        "amount": 20,
        "unit": "seconds"
      }
    },
    {
      "id": "08eaf03e-4bb9-4e52-b34e-7b9acdc50d0c",
      "name": "Poll Generation History",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1480,
        -80
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.COMFYUI_URL }}/history/{{ $('Queue On ComfyUI').first().json.prompt_id }}",
        "options": {
          "timeout": 15000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "586cf1db-eb15-4e89-9d60-61f66a52198e",
      "name": "Check Completion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1700,
        -80
      ],
      "parameters": {
        "jsCode": "// ComfyUI returns {} until the job lands in history. Give up after ~5 minutes\n// rather than looping forever on a wedged GPU queue. Elapsed time is used instead\n// of a counter because the poll response replaces $json on every loop.\nconst MAX_WAIT_MS = 5 * 60 * 1000, POLL_MS = 20 * 1000;\nconst ctx  = $('Build ComfyUI Graph').first().json;\nconst pid  = $('Queue On ComfyUI').first().json.prompt_id;\nconst hist = $input.first().json[pid] || {};\nconst elapsed = Date.now() - new Date(ctx.startedAt).getTime();\n\nconst outputs = hist.outputs || null;\nconst images  = outputs ? Object.values(outputs).flatMap(o => o.images || []) : [];\n\nreturn [{ json: {\n  ...ctx,\n  promptId: pid,\n  attempt: Math.max(1, Math.round(elapsed / POLL_MS)),\n  elapsedSec: Math.round(elapsed / 1000),\n  done: images.length > 0,\n  timedOut: images.length === 0 && elapsed >= MAX_WAIT_MS,\n  images: images.map(i => ({\n    filename: i.filename, subfolder: i.subfolder, type: i.type,\n    url: `${$env.COMFYUI_URL}/view?filename=${encodeURIComponent(i.filename)}`\n         + `&subfolder=${encodeURIComponent(i.subfolder||'')}&type=${i.type||'output'}`\n  }))\n}}];"
      }
    },
    {
      "id": "c8bade5f-4622-426c-871d-2092bf43a099",
      "name": "Generation Done?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1920,
        -80
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{$json.done}}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "id": "4256f069-9396-5b1a-b1a6-4650909c9d49"
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "ac8f9698-5604-448d-b90b-918805cd622f",
      "name": "Gave Up Waiting?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1920,
        140
