# Copy to .env and fill in before `docker compose up -d`. .env is gitignored: never commit it.
# n8n itself asks you to create an owner account on first visit to http://localhost:5678.

N8N_HOST=localhost
GENERIC_TIMEZONE=UTC

# ---- Google Sheets (the ID is the long string in the sheet URL) ----
# project 1: tabs "Leads", "Rejected Submissions"
CRM_SHEET_ID=
# project 2: tabs "Pending Approval", "Invoice Ledger", "Needs Review"
FINANCE_SHEET_ID=
# projects 3 & 7: tabs "Uptime Log", "Incidents", "Ops Log"
OPS_SHEET_ID=
# projects 4-6: tabs "Creative Briefs", "Asset Manifest", "Failed Renders", "DCO Decision Log"
CREATIVE_SHEET_ID=

# ---- Project 4: asset store ----
ASSET_STORE_URL=https://assets.example.com
ASSET_STORE_TOKEN=

# ---- Project 5: ComfyUI + hand-off back into this n8n ----
COMFYUI_URL=http://comfyui:8188
N8N_BASE_URL=http://localhost:5678

# ---- Project 6: ad platform + affiliate network ----
ADS_API_URL=https://ads.example.com/v1
ADS_API_TOKEN=
AFFILIATE_API_URL=https://affiliate.example.com/v1
AFFILIATE_API_KEY=
DCO_MIN_IMPRESSIONS=1000
DCO_TARGET_ROAS=1.3
DCO_SCALE_STEP=1.2
