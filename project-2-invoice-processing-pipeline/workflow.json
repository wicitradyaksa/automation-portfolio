{
  "name": "Invoice Intake & Validation Pipeline",
  "nodes": [
    {
      "id": "bb01fa7a-6bcc-4651-b076-9424f50349c5",
      "name": "Note - Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -320
      ],
      "parameters": {
        "content": "## Automated Invoice Intake & Validation Pipeline\nWatches the AP inbox, pulls the PDF text out of each invoice, parses the key fields, routes anything over $1,000 to a manager for approval in Slack, and flags anything it couldn't confidently parse for manual review \u2014 instead of a human opening every attachment.",
        "height": 240,
        "width": 440,
        "color": 5
      }
    },
    {
      "id": "93640622-ec94-4bdf-a449-129ba245f361",
      "name": "Watch Invoices Inbox",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2,
      "position": [
        -40,
        0
      ],
      "parameters": {
        "mailbox": "INBOX",
        "postProcessAction": "read",
        "format": "simple",
        "downloadAttachments": true,
        "options": {}
      },
      "credentials": {
        "imap": {
          "id": "imap_cred",
          "name": "Accounts Payable Inbox (demo)"
        }
      }
    },
    {
      "id": "e3a914ef-63fa-44c5-a6b5-1231bd39f193",
      "name": "Has PDF Attachment?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "pdf-mime-check",
              "leftValue": "={{ $binary.attachment_0?.mimeType ?? '' }}",
              "rightValue": "pdf",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "6de8b17f-0bb9-4bb8-aa76-2e875d45d2b8",
      "name": "Extract PDF Text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        420,
        -70
      ],
      "parameters": {
        "operation": "pdf",
        "binaryPropertyName": "attachment_0",
        "options": {}
      }
    },
    {
      "id": "dd267781-5097-466e-b873-35d08052d376",
      "name": "Parse Invoice Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        -70
      ],
      "parameters": {
        "jsCode": "// Very small rules-based parser: pulls invoice number, vendor, amount, due date\n// out of the extracted PDF text using regex. Swap for an LLM/OCR call for messier PDFs.\nconst text = $input.first().json.text || '';\n\nconst invoiceNumber = (text.match(/invoice\\s*#?\\s*([A-Z0-9-]{4,})/i) || [])[1] || null;\nconst amountMatch = text.match(/total\\s*(?:due)?\\s*[:\\$]?\\s*([0-9,]+\\.\\d{2})/i);\nconst amount = amountMatch ? parseFloat(amountMatch[1].replace(/,/g, '')) : null;\nconst dueDateMatch = text.match(/due\\s*date\\s*[:\\-]?\\s*([0-9]{1,2}\\/[0-9]{1,2}\\/[0-9]{2,4})/i);\nconst vendorMatch = text.match(/^(.*?)\\n/);\n\nconst complete = Boolean(invoiceNumber && amount && dueDateMatch);\n\nreturn [{\n  json: {\n    invoiceNumber,\n    vendor: vendorMatch ? vendorMatch[1].trim() : 'Unknown',\n    amount,\n    dueDate: dueDateMatch ? dueDateMatch[1] : null,\n    complete,\n    receivedAt: new Date().toISOString(),\n    // Kept for the manual-review queue; Sheets cells cap at 50k characters.\n    rawText: text.slice(0, 5000)\n  }\n}];"
      }
    },
    {
      "id": "1824825e-53fa-4b11-b7f8-86c73cb5c285",
      "name": "Fields Complete?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        860,
        -70
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{$json.complete}}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "id": "52755bfe-a052-553e-a9ef-8e4416216939"
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "4b11080d-162b-4187-8497-a1a8281f4c84",
      "name": "Needs Manager Approval?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1080,
        -140
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{$json.amount}}",
              "rightValue": 1000,
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "id": "4cd12352-edda-5932-9b9e-1aa5415dc2a4"
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
