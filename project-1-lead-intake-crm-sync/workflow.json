      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.email ?? '' }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              },
              "id": "248ef2fc-57f5-52c4-b4a8-20d9fade5ef6"
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "10135588-f8ba-4e20-a1db-75fba254752e",
      "name": "Update Existing Row",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1060,
