          "id": "gsheets_cred",
          "name": "Google Sheets - CRM (demo)"
        }
      }
    },
    {
      "id": "fd35b330-9db4-4611-878c-6a9b2f526db4",
      "name": "Notify Sales (Slack)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        1300,
        -60
