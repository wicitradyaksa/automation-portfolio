{
  "name": "Lead Intake & CRM Sync",
  "nodes": [
    {
      "id": "3d44e12a-54cc-4fc4-bab3-9c69f6d95ff1",
      "name": "Note - Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -320
      ],
      "parameters": {
        "content": "## Multi-Channel Lead Intake & CRM Sync\nAccepts leads from any web form/ad landing page, validates + dedupes them against a lightweight Google-Sheets CRM, alerts sales in Slack, and auto-replies to the prospect \u2014 all in a single execution.",
        "height": 220,
        "width": 420,
        "color": 4
      }
    },
    {
      "id": "3290de59-998b-4c39-a166-bb8e6c4e57d2",
      "name": "Lead Form Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -40,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-intake",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "d47cd2fb-b303-5eb9-abf8-946b4893f094"
    },
    {
      "id": "aba4485c-19f9-487e-a1f8-14a114f150d5",
      "name": "Normalize & Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        180,
        0
      ],
      "parameters": {
        "jsCode": "// Normalize incoming payload from any source (site form, ad landing page, partner API)\n// into one lead shape, and flag basic validation problems.\nconst body = $input.first().json.body ?? $input.first().json;\n\nconst email = (body.email || '').trim().toLowerCase();\nconst emailValid = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\n\nreturn [{\n  json: {\n    firstName: (body.firstName || body.first_name || '').trim(),\n    lastName: (body.lastName || body.last_name || '').trim(),\n    email,\n    company: (body.company || '').trim(),\n    source: body.source || 'website_form',\n    submittedAt: new Date().toISOString(),\n    valid: emailValid\n  }\n}];"
      }
    },
    {
      "id": "79359694-5693-43ab-85b0-fcffcf0c2697",
      "name": "Valid Lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{$json.valid}}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "id": "90f06a37-1719-5eb2-bf6d-b1c4015f2879"
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "5266c5bb-a979-4961-8a15-1aab92222a08",
      "name": "Check For Duplicate",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        620,
        -90
      ],
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.CRM_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "email",
              "lookupValue": "={{$json.email}}"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "gsheets_cred",
          "name": "Google Sheets - CRM (demo)"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "bc58ddd7-9431-4bba-a8d7-60a3b4bcae88",
