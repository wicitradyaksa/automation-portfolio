      "name": "Send Confirmation Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1520,
        -60
      ],
      "parameters": {
        "fromEmail": "hello@yourcompany.com",
        "toEmail": "={{$('Normalize & Validate').item.json.email}}",
        "subject": "=Thanks for reaching out, {{$('Normalize & Validate').item.json.firstName}}!",
        "text": "=Hi {{$('Normalize & Validate').item.json.firstName}},\n\nThanks for your interest \u2014 a member of our team will follow up within one business day.\n\nBest,\nThe Team",
        "emailFormat": "text",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "smtp_cred",
          "name": "Transactional SMTP (demo)"
        }
      }
    },
