      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "#sales-alerts",
          "mode": "name"
        },
        "text": "=:rotating_light: {{ $('Check For Duplicate').item.json.email ? 'Returning lead (touch #' + (Number($('Check For Duplicate').item.json.touchCount || 0) + 1) + ')' : 'New lead' }}: *{{ [$('Normalize & Validate').item.json.firstName, $('Normalize & Validate').item.json.lastName].filter(Boolean).join(' ') || 'Unknown name' }}*{{ $('Normalize & Validate').item.json.company ? ' (' + $('Normalize & Validate').item.json.company + ')' : '' }} via {{ $('Normalize & Validate').item.json.source }}\nEmail: {{ $('Normalize & Validate').item.json.email }}",
        "otherOptions": {}
      },
      "credentials": {
        "slackApi": {
          "id": "slack_cred",
          "name": "Slack - Sales Workspace (demo)"
        }
      }
    },
    {
