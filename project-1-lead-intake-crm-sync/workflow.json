        "documentId": {
          "__rl": true,
          "value": "={{$json.sheetId}}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "email",
              "lookupValue": "={{$json.email}}"
            }
          ]
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "gsheets_cred",
          "name": "Google Sheets - CRM (demo)"
        }
      }
    },
