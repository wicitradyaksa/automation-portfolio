            "lastTouchedAt": "={{ $now.toISO() }}",
            "touchCount": "={{ Number($json.touchCount || 0) + 1 }}"
          },
          "matchingColumns": [
            "email"
          ],
          "schema": []
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "gsheets_cred",
          "name": "Google Sheets - CRM (demo)"
        }
      }
    },
