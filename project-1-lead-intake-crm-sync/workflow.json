            "company": "={{$('Normalize & Validate').item.json.company}}",
            "source": "={{$('Normalize & Validate').item.json.source}}",
            "createdAt": "={{$('Normalize & Validate').item.json.submittedAt}}",
            "status": "new",
            "touchCount": 1,
            "lastTouchedAt": "={{ $now.toISO() }}"
          },
          "matchingColumns": [],
