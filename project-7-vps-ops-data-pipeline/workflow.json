    {
      "id": "3e3819da-9ea8-4f6b-bf36-ba0d3a685599",
      "name": "Quarantine Bad Load",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [
        2360,
        120
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Move today's suspect rows aside so downstream dashboards read clean data.\nWITH moved AS (\n  DELETE FROM events WHERE loaded_at::date = CURRENT_DATE RETURNING *\n)\nINSERT INTO events_quarantine SELECT *, $1 AS reason FROM moved;",
        "options": {
          "queryReplacement": "={{$json.dqFailures}}"
        }
      },
      "credentials": {
